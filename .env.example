# ============================================================
# LANI Academy — environment variables
# Copy this file to `.env` and fill in the values.
# Only the VITE_* vars belong in this file (they're read by the
# browser app). The Resend secrets are set on Supabase, not here.
# ============================================================

# ── Supabase (REQUIRED) ─────────────────────────────────────
# Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ── Payment gateways (OPTIONAL) ─────────────────────────────
# Paystack transactions are initialized by the authenticated Supabase Edge
# Function, so no Paystack key is required in the browser environment.
# Flutterwave still uses its public browser key; leave it blank for demo mode.
# Flutterwave: Dashboard → Settings → API Keys
VITE_FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxxxxxxxxxxxxxxxxxx-X

# ── Email two-factor at login (OPTIONAL) ────────────────────
# Requires the send-email function + Resend key (below) to be live,
# otherwise users can't receive their code. Keep false until then.
VITE_ENABLE_2FA=false

# ── Analytics (OPTIONAL) ────────────────────────────────────
# Leave blank to disable. GA4 measurement id + Microsoft Clarity id.
VITE_GA_ID=
VITE_CLARITY_ID=

# ── Course-material seeding (OPTIONAL, one-off) ─────────────
# Used only by `npm run seed:materials`, which uploads sample course
# materials into your Supabase `media` bucket through the real upload path
# and points courses at those self-hosted files.
# Provide an existing admin/facilitator login (uploads run as that user):
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# ...or bypass RLS with the service-role key (Dashboard → Settings → API).
# Never commit this or expose it in the browser app.
SUPABASE_SERVICE_ROLE_KEY=


# ============================================================
# SERVER-SIDE SECRETS — do NOT put these in this .env file.
# They power Supabase Edge Functions for Paystack and Resend.
# Set them with the Supabase CLI instead:
#
#   supabase secrets set \
#     PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx \
#     RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx \
#     EMAIL_FROM="LANI Academy <noreply@yourdomain.com>"
#
#   PAYSTACK_SECRET_KEY → use sk_test_ while testing, then replace with sk_live_
#   RESEND_API_KEY  → resend.com → API Keys
#   EMAIL_FROM      → a verified sender/domain in Resend
# ============================================================


#commit to trigger redeployment
